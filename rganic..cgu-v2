[36m@@ -0,0 +1,94 @@[m
[32m+[m[32mimport { useState } from "react";[m
[32m+[m[32mimport { useLocation } from "wouter";[m
[32m+[m[32mimport { useQuery, useQueryClient } from "@tanstack/react-query";[m
[32m+[m[32mimport { useAuth } from "@/hooks/use-auth";[m
[32m+[m[32mimport { CGU_VERSION, CGU_CHECK_PATIENT, CGU_CHECK_PRO, CGU_REACCEPT_TEXT, RESEARCH_CONSENT_TITLE, RESEARCH_CONSENT_TEXT } from "@shared/cgu";[m
[32m+[m
[32m+[m[32m// Écran bloquant de ré-acceptation des CGU (version 2026-11-v2).[m
[32m+[m[32m// Tout compte connecté dont la version acceptée est absente ou différente doit cocher[m
[32m+[m[32m// la case et valider : continuer à utiliser l'appli ne vaut PAS acceptation.[m
[32m+[m[32m// Les pages de lecture (CGU, confidentialité, vérification d'ordonnance) restent ouvertes.[m
[32m+[m[32mconst OPEN_PATHS = [/^\/cgu\/?$/, /^\/confidentialite\/?$/, /^\/derm\/conditions\/?$/, /^\/verif(\/|$)/, /^\/avis\//];[m
[32m+[m
[32m+[m[32mtype CguState = { required: string; version: string | null; ok: boolean; pro: boolean };[m
[32m+[m
[32m+[m[32mconst C = { ink: "#17392c", body: "#3d4f48", muted: "#5f6f69", line: "#e3e8e2", accent: "#164034", soft: "#e7eedc", err: "#b42318" };[m
[32m+[m
[32m+[m[32mexport function CguGate() {[m
[32m+[m[32m  const { user, logout } = useAuth();[m
[32m+[m[32m  const [path] = useLocation();[m
[32m+[m[32m  const qc = useQueryClient();[m
[32m+[m[32m  const { data } = useQuery<CguState | null>({[m
[32m+[m[32m    queryKey: ["/api/me/cgu"],[m
[32m+[m[32m    enabled: !!user,[m
[32m+[m[32m    staleTime: 1000 * 60 * 10,[m
[32m+[m[32m    queryFn: async () => {[m
[32m+[m[32m      const r = await fetch("/api/me/cgu", { credentials: "include" });[m
[32m+[m[32m      if (!r.ok) return null; // jamais bloquer sur une erreur réseau ou serveur[m
[32m+[m[32m      return r.json();[m
[32m+[m[32m    },[m
[32m+[m[32m  });[m
[32m+[m[32m  const [cgu, setCgu] = useState(false);[m
[32m+[m[32m  const [research, setResearch] = useState(false);[m
[32m+[m[32m  const [busy, setBusy] = useState(false);[m
[32m+[m[32m  const [err, setErr] = useState("");[m
[32m+[m
[32m+[m[32m  if (!user || !data || data.ok || OPEN_PATHS.some((re) => re.test(path))) return null;[m
[32m+[m
[32m+[m[32m  const accept = async () => {[m
[32m+[m[32m    if (!cgu) return;[m
[32m+[m[32m    setBusy(true); setErr("");[m
[32m+[m[32m    try {[m
[32m+[m[32m      const r = await fetch("/api/me/cgu", {[m
[32m+[m[32m        method: "POST", credentials: "include", headers: { "Content-Type": "application/json" },[m
[32m+[m[32m        body: JSON.stringify({ version: CGU_VERSION, accepted: true, ...(data.pro ? {} : { research }) }),[m
[32m+[m[32m      });[m
[32m+[m[32m      const d = await r.json().catch(() => ({}));[m
[32m+[m[32m      if (!r.ok) throw new Error(d?.message || "Enregistrement impossible. Réessayez.");[m
[32m+[m[32m      qc.setQueryData(["/api/me/cgu"], { ...data, version: CGU_VERSION, ok: true });[m
[32m+[m[32m      if (!data.pro) qc.invalidateQueries({ queryKey: ["/api/me/consents"] });[m
[32m+[m[32m    } catch (e: any) { setErr(e.message); }[m
[32m+[m[32m    setBusy(false);[m
[32m+[m[32m  };[m
[32m+[m
[32m+[m[32m  const box = (on: boolean): React.CSSProperties => ({[m
[32m+[m[32m    width: 18, height: 18, flex: "none", marginTop: 2, borderRadius: 4,[m
[32m+[m[32m    ...(on ? { background: C.accent, color: "#fff", display: "flex", alignItems: "center", justifyContent: "center", fontSize: 12, fontWeight: 800 } : { border: `1.5px solid #9aa8a2`, background: "#fff" }),[m
[32m+[m[32m  });[m
[32m+[m
[32m+[m[32m  return ([m
[32m+[m[32m    <div role="dialog" aria-modal="true" aria-labelledby="cgu-gate-title" data-testid="cgu-gate"[m
[32m+[m[32m      style={{ position: "fixed", inset: 0, zIndex: 400, background: "rgba(13,38,32,.6)", backdropFilter: "blur(4px)", display: "grid", placeItems: "center", padding: 16, fontFamily: "'DM Sans', system-ui, sans-serif" }}>[m
[32m+[m[32m      <div style={{ width: "100%", maxWidth: 520, maxHeight: "calc(100vh - 32px)", overflowY: "auto", background: "#fff", borderRadius: 18, padding: 24, color: C.ink, display: "flex", flexDirection: "column", gap: 14 }}>[m
[32m+[m[32m        <h2 id="cgu-gate-title" style={{ margin: 0, fontSize: 19, fontWeight: 700, fontFamily: "Manrope, 'DM Sans', sans-serif" }}>Conditions générales mises à jour</h2>[m
[32m+[m[32m        <p style={{ margin: 0, fontSize: 13.5, lineHeight: 1.6, color: C.body }}>{CGU_REACCEPT_TEXT}</p>[m
[32m+[m[32m        <a href={data.pro ? "/derm/conditions" : "/cgu"} target="_blank" rel="noreferrer" data-testid="cgu-gate-read"[m
[32m+[m[32m          style={{ alignSelf: "flex-start", fontSize: 13, fontWeight: 700, color: C.accent }}>Lire les Conditions générales (version {CGU_VERSION})</a>[m
[32m+[m
[32m+[m[32m        <label style={{ display: "flex", gap: 10, alignItems: "flex-start", padding: 12, borderRadius: 10, border: `1px solid ${cgu ? C.accent : C.line}`, cursor: "pointer" }}>[m
[32m+[m[32m          <input type="checkbox" checked={cgu} onChange={(e) => { setCgu(e.target.checked); setErr(""); }} data-testid="cgu-gate-check" style={{ position: "absolute", opacity: 0, width: 1, height: 1 }} />[m
[32m+[m[32m          <span style={box(cgu)} aria-hidden>{cgu ? "✓" : ""}</span>[m
[32m+[m[32m          <span style={{ fontSize: 12.5, lineHeight: 1.55 }}>{data.pro ? CGU_CHECK_PRO : CGU_CHECK_PATIENT}</span>[m
[32m+[m[32m        </label>[m
[32m+[m
[32m+[m[32m        {!data.pro && ([m
[32m+[m[32m          <label style={{ display: "flex", gap: 10, alignItems: "flex-start", padding: 12, borderRadius: 10, border: `1px solid ${research ? C.accent : C.line}`, background: "#f8f8f6", cursor: "pointer" }}>[m
[32m+[m[32m            <input type="checkbox" checked={research} onChange={(e) => setResearch(e.target.checked)} data-testid="cgu-gate-research" style={{ position: "absolute", opacity: 0, width: 1, height: 1 }} />[m
[32m+[m[32m            <span style={box(research)} aria-hidden>{research ? "✓" : ""}</span>[m
[32m+[m[32m            <span style={{ fontSize: 12, lineHeight: 1.55, color: C.body }}><strong style={{ color: C.ink }}>{RESEARCH_CONSENT_TITLE}</strong> {RESEARCH_CONSENT_TEXT}</span>[m
[32m+[m[32m          </label>[m
[32m+[m[32m        )}[m
[32m+[m
[32m+[m[32m        {err && <span style={{ fontSize: 12.5, color: C.err }}>{err}</span>}[m
[32m+[m[32m        <button type="button" disabled={!cgu || busy} onClick={accept} data-testid="cgu-gate-accept"[m
[32m+[m[32m          style={{ height: 46, borderRadius: 12, border: 0, background: cgu ? C.accent : "#b9c4bf", color: "#fff", fontSize: 14, fontWeight: 800, cursor: cgu && !busy ? "pointer" : "default" }}>[m
[32m+[m[32m          {busy ? "Enregistrement…" : "Accepter et continuer"}[m
[32m+[m[32m        </button>[m
[32m+[m[32m        <span style={{ fontSize: 11.5, lineHeight: 1.5, color: C.muted, textAlign: "center" }}>[m
[32m+[m[32m          Si vous n'acceptez pas, vous pouvez vous déconnecter et demander la fermeture de votre compte.{" "}[m
[32m+[m[32m          <button type="button" onClick={() => logout()} data-testid="cgu-gate-logout" style={{ border: 0, background: "none", padding: 0, color: C.accent, fontWeight: 700, cursor: "pointer", fontSize: 11.5 }}>Se déconnecter</button>[m
[32m+[m[32m        </span>[m
[32m+[m[32m      </div>[m
[32m+[m[32m    </div>[m
[32m+[m[32m  );[m
[32m+[m[32m}[m
