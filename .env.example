# Copie ce fichier en ".env" (même dossier) et remplis TES valeurs.
# ⚠️ Le .env ne doit JAMAIS être commité (déjà dans .gitignore).

# --- OBLIGATOIRE pour démarrer ---
DATABASE_URL=

# --- Pour que l'analyse IA fonctionne ---
GEMINI_API_KEY=

# --- Optionnels (pour tout tester en local) ---
GROQ_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=
MONETBIL_SERVICE_KEY=
MONETBIL_SERVICE_SECRET=
ADMIN_KEY=
PUBLIC_BASE_URL=http://localhost:8080
PORT=8080
